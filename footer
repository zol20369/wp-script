#!/bin/bash
# Replace any domain for /login /register /contact-us in wp_options only

NEW_URL_VALUE=""

while getopts "N:" opt; do
  case $opt in
    N) NEW_URL_VALUE="$OPTARG" ;;
    \?) exit 1 ;;
  esac
done

if [ -z "$NEW_URL_VALUE" ]; then
    echo "Usage: $0 -N https://newdomain.com"
    exit 1
fi

BASE_DIR="$HOME"
LOG_FILE="$HOME/update_wp.log"

> "$LOG_FILE"
echo "------ Update started at $(date) ------" >> "$LOG_FILE"

ALL_SITES_LIST=$(find -L "$BASE_DIR" -name "wp-config.php" ! -path "*/.*")
TOTAL_SITES=$(echo "$ALL_SITES_LIST" | grep -c "wp-config.php")

if [ "$TOTAL_SITES" -eq 0 ]; then
    echo "Error: No WordPress installations found." | tee -a "$LOG_FILE"
    exit 1
fi

echo "Found $TOTAL_SITES WordPress site(s)" | tee -a "$LOG_FILE"

SUCCESS_COUNT=0
FAILED_COUNT=0
CURRENT_INDEX=0

while read -r config_path; do
    [ -z "$config_path" ] && continue

    ((CURRENT_INDEX++))
    SITE_PATH=$(dirname "$config_path")
    DISPLAY_NAME=$(echo "$SITE_PATH" | sed "s|$BASE_DIR/||")

    (
        cd "$SITE_PATH" || exit 1

        DOMAIN=$(wp option get home --allow-root 2>/dev/null || echo "Unknown Domain")
        NEW_BASE="${NEW_URL_VALUE%/}"

        echo "------------------------------------------------" | tee -a "$LOG_FILE"
        echo "[$CURRENT_INDEX/$TOTAL_SITES] Site: $DOMAIN ($DISPLAY_NAME)" | tee -a "$LOG_FILE"

        echo "    [DB] Replacing /login links..." | tee -a "$LOG_FILE"
        wp search-replace 'https?://[^"'\''[:space:]]+/login/?' "${NEW_BASE}/login" wp_options \
            --include-columns=option_value \
            --regex \
            --regex-flags='i' \
            --allow-root >> "$LOG_FILE" 2>&1

        echo "    [DB] Replacing /register links..." | tee -a "$LOG_FILE"
        wp search-replace 'https?://[^"'\''[:space:]]+/register/?' "${NEW_BASE}/register" wp_options \
            --include-columns=option_value \
            --regex \
            --regex-flags='i' \
            --allow-root >> "$LOG_FILE" 2>&1

        echo "    [DB] Replacing /contact-us links..." | tee -a "$LOG_FILE"
        wp search-replace 'https?://[^"'\''[:space:]]+/contact-us/?' "${NEW_BASE}/contact-us" wp_options \
            --include-columns=option_value \
            --regex \
            --regex-flags='i' \
            --allow-root >> "$LOG_FILE" 2>&1

        echo "    [CACHE] Flushing cache..." | tee -a "$LOG_FILE"
        wp cache flush --allow-root &>/dev/null
        wp varnish purge --allow-root &>/dev/null 2>&1

        exit 0
    )

    if [ $? -eq 0 ]; then
        ((SUCCESS_COUNT++))
    else
        ((FAILED_COUNT++))
    fi

done <<< "$ALL_SITES_LIST"

echo "------------------------------------------------" | tee -a "$LOG_FILE"
echo "Summary: Success $SUCCESS_COUNT | Failed $FAILED_COUNT" | tee -a "$LOG_FILE"
echo "Detailed Log: $LOG_FILE"
