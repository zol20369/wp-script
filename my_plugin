#!/bin/bash
# zol2o - Full WordPress Report Mode

BASE_DIR="$HOME/applications"
LOG_FILE="$HOME/wp_report.log"
CSV_FILE="$HOME/wp_full_report.csv"

> "$LOG_FILE"
echo "------ WP REPORT started at $(date) ------" | tee -a "$LOG_FILE"

# เขียนหัว CSV
echo "Domain,Theme,Plugin,Status,Version" > "$CSV_FILE"

ALL_SITES_LIST=$(find -L "$BASE_DIR" -name "wp-config.php" ! -path "*/.*")
TOTAL_SITES=$(echo "$ALL_SITES_LIST" | grep -c "wp-config.php")

if [ "$TOTAL_SITES" -eq 0 ]; then
  echo "No WordPress installations found." | tee -a "$LOG_FILE"
  exit 1
fi

echo "Found $TOTAL_SITES WordPress sites" | tee -a "$LOG_FILE"

CURRENT_INDEX=0

while read -r config_path; do
  [ -z "$config_path" ] && continue

  ((CURRENT_INDEX++))
  SITE_PATH=$(dirname "$config_path")
  DISPLAY_NAME=$(echo "$SITE_PATH" | sed "s|$BASE_DIR/||")

  (
    cd "$SITE_PATH" || exit 1

    if ! wp core is-installed --allow-root >/dev/null 2>&1; then
      echo "[SKIP] Not WP: $DISPLAY_NAME" >> "$LOG_FILE"
      exit 0
    fi

    DOMAIN=$(wp option get home --allow-root 2>/dev/null || echo "Unknown")
    THEME=$(wp theme list --status=active --field=name --allow-root)

    echo "------------------------------------------------" | tee -a "$LOG_FILE"
    echo "[$CURRENT_INDEX/$TOTAL_SITES] $DOMAIN" | tee -a "$LOG_FILE"
    echo "Theme: $THEME" | tee -a "$LOG_FILE"

    # ดึง plugin ทั้งหมด
    wp plugin list --fields=name,status,version --format=csv --allow-root | tail -n +2 | while IFS=',' read -r name status version; do
        
        echo "   - $name ($status) v$version" | tee -a "$LOG_FILE"

        # เขียนลง CSV
        echo "$DOMAIN,$THEME,$name,$status,$version" >> "$CSV_FILE"

    done

    exit 0
  )

done <<< "$ALL_SITES_LIST"

echo "------------------------------------------------" | tee -a "$LOG_FILE"
echo "Report Saved:"
echo "CSV: $CSV_FILE"
echo "LOG: $LOG_FILE"
