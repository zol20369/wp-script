#!/bin/bash
# zol2o - Full WordPress Report Mode (Fixed & safer)

BASE_DIR="$HOME/applications"
LOG_FILE="$HOME/wp_report.log"
CSV_FILE="$HOME/wp_full_report.csv"

> "$LOG_FILE"
echo "------ WP REPORT started at $(date) ------" | tee -a "$LOG_FILE"

# เขียนหัว CSV
echo "Domain,Theme,Plugin,Status,Version" > "$CSV_FILE"

# นับ/วนแบบปลอดภัย (NUL-separated)
mapfile -d '' ALL_SITES_ARR < <(find -L "$BASE_DIR" -name "wp-config.php" ! -path "*/.*" -print0)
TOTAL_SITES="${#ALL_SITES_ARR[@]}"

if [ "$TOTAL_SITES" -eq 0 ]; then
  echo "No WordPress installations found in $BASE_DIR" | tee -a "$LOG_FILE"
  exit 1
fi

echo "Found $TOTAL_SITES WordPress sites" | tee -a "$LOG_FILE"

CURRENT_INDEX=0
PROCESSED=0
SKIPPED=0

# ฟังก์ชัน escape CSV (กัน comma/quote)
csv_escape() {
  local s="$1"
  s="${s//\"/\"\"}"
  printf "\"%s\"" "$s"
}

for config_path in "${ALL_SITES_ARR[@]}"; do
  [ -z "$config_path" ] && continue

  ((CURRENT_INDEX++))
  SITE_PATH="$(dirname "$config_path")"
  DISPLAY_NAME="$(echo "$SITE_PATH" | sed "s|$BASE_DIR/||")"

  (
    cd "$SITE_PATH" || exit 1

    if ! command -v wp >/dev/null 2>&1; then
      echo "[ERR] wp-cli not found: $DISPLAY_NAME" >> "$LOG_FILE"
      exit 1
    fi

    if ! wp core is-installed --allow-root >/dev/null 2>&1; then
      echo "[SKIP] Not WP installed: $DISPLAY_NAME" >> "$LOG_FILE"
      exit 0
    fi

    DOMAIN="$(wp option get home --allow-root 2>/dev/null || echo "Unknown")"
    THEME="$(wp theme list --status=active --field=name --allow-root 2>/dev/null | head -n 1)"

    echo "------------------------------------------------" | tee -a "$LOG_FILE"
    echo "[$CURRENT_INDEX/$TOTAL_SITES] $DOMAIN" | tee -a "$LOG_FILE"
    echo "Theme: $THEME" | tee -a "$LOG_FILE"

    # ดึง plugin ทั้งหมด
    wp plugin list --fields=name,status,version --format=csv --allow-root 2>/dev/null \
      | tail -n +2 \
      | while IFS=',' read -r name status version; do
          echo "   - $name ($status) v$version" | tee -a "$LOG_FILE"

          # เขียนลง CSV แบบปลอดภัย
          echo "$(csv_escape "$DOMAIN"),$(csv_escape "$THEME"),$(csv_escape "$name"),$(csv_escape "$status"),$(csv_escape "$version")" >> "$CSV_FILE"
        done

    exit 0
  )

  rc=$?
  if [ $rc -eq 0 ]; then
    # ถ้าเป็น SKIP จะ exit 0 เหมือนกัน เรานับแยกจาก log ไม่ง่าย
    ((PROCESSED++))
  else
    ((SKIPPED++))
  fi
done

echo "------------------------------------------------" | tee -a "$LOG_FILE"
echo "Report Saved:" | tee -a "$LOG_FILE"
echo "CSV: $CSV_FILE" | tee -a "$LOG_FILE"
echo "LOG: $LOG_FILE" | tee -a "$LOG_FILE"
echo "Processed: $PROCESSED / $TOTAL_SITES (Errors: $SKIPPED)" | tee -a "$LOG_FILE"
