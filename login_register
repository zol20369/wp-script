#!/bin/bash
# zol2o - Pro Version (Optimized for Blocksy & Global Search)
# ✅ Update only target links in pages: login / register / contact-us
# ✅ Optional: Blocksy Shortcut Bar replace in wp_options
# ✅ Optional: Global DB replace (all tables)

LOGIN_REDIRECT_URL=""
REGISTER_REDIRECT_URL=""
NEW_CONTACT_URL=""
OLD_URL_TARGET=""
NEW_URL_VALUE=""
FIX_SHORTCUT_URL=""

while getopts "L:R:C:O:N:F:" opt; do
  case $opt in
    L) LOGIN_REDIRECT_URL="$OPTARG" ;;
    R) REGISTER_REDIRECT_URL="$OPTARG" ;;
    C) NEW_CONTACT_URL="$OPTARG" ;;
    O) OLD_URL_TARGET="$OPTARG" ;;
    N) NEW_URL_VALUE="$OPTARG" ;;
    F) FIX_SHORTCUT_URL="$OPTARG" ;;
    \?) exit 1 ;;
  esac
done

# เช็ค Argument
if [ -z "$LOGIN_REDIRECT_URL" ] && [ -z "$REGISTER_REDIRECT_URL" ] && [ -z "$NEW_CONTACT_URL" ] && [ -z "$OLD_URL_TARGET" ] && [ -z "$FIX_SHORTCUT_URL" ]; then
  echo "Usage:"
  echo "  $0 -L new_login_url -R new_register_url -C new_contact_url -O old_url"
  echo "  $0 -O old_url -N new_url            # Global DB replace (all tables)"
  echo "  $0 -F target_url -O search_url      # Blocksy Shortcut Bar replace (wp_options)"
  exit 1
fi

BASE_DIR="$HOME/applications"
LOG_FILE="$HOME/update_wp.log"

> "$LOG_FILE"
echo "------ Update started at $(date) ------" >> "$LOG_FILE"

ALL_SITES_LIST=$(find -L "$BASE_DIR" -name "wp-config.php" ! -path "*/.*")
TOTAL_SITES=$(echo "$ALL_SITES_LIST" | grep -c "wp-config.php")

if [ "$TOTAL_SITES" -eq 0 ]; then
  echo "Error: No WordPress installations found." | tee -a "$LOG_FILE"
  exit 1
fi

echo "Found $TOTAL_SITES WordPress" | tee -a "$LOG_FILE"

SUCCESS_COUNT=0
FAILED_COUNT=0
CURRENT_INDEX=0

while read -r config_path; do
  [ -z "$config_path" ] && continue

  ((CURRENT_INDEX++))
  SITE_PATH=$(dirname "$config_path")
  DISPLAY_NAME=$(echo "$SITE_PATH" | sed "s|$BASE_DIR/||")

  (
    cd "$SITE_PATH" || exit 1

    DOMAIN=$(wp option get home --allow-root 2>/dev/null || echo "Unknown Domain")
    echo "------------------------------------------------" | tee -a "$LOG_FILE"
    echo "[$CURRENT_INDEX/$TOTAL_SITES] Site: $DOMAIN ($DISPLAY_NAME)" | tee -a "$LOG_FILE"

    # Escape string for safe sed replacement
    sed_escape() {
      # escape: \ / & |
      printf '%s' "$1" | sed -e 's/[\/&|\\]/\\&/g'
    }

    # Find WP page ID by slug or slug-2 (published pages)
    find_page_id() {
      local slug="$1"
      wp post list --post_type=page --post_status=publish \
        --fields=ID,post_name --format=csv --allow-root \
        | awk -F',' -v s="$slug" '($2==s || $2==s"-2"){print $1; exit}'
    }

    # --- ฟังก์ชัน 1 (ปรับใหม่): อัปเดต "เฉพาะลิงก์เดิม" ในหน้า Page (Content) ---
    # ใช้ร่วมกับ -L/-R/-C โดยให้ -O เป็น "ลิงก์เดิม" ที่จะหา (old_url)
    # แล้ว -L/-R/-C เป็น "ลิงก์ใหม่" ของแต่ละหน้า
    replace_in_page_content() {
      local slug="$1"      # login / register / contact-us
      local label="$2"     # Login / Register / Contact
      local old_url="$3"   # old url to find
      local new_url="$4"   # new url to replace

      [ -z "$old_url" ] && return 0
      [ -z "$new_url" ] && return 0

      local page_id
      page_id=$(find_page_id "$slug")

      if [ -z "$page_id" ]; then
        echo "    [SKIP] Page not found: $label ($slug)" | tee -a "$LOG_FILE"
        return 0
      fi

      local old_content new_content
      old_content=$(wp post get "$page_id" --field=post_content --allow-root 2>/dev/null || true)

      local old_esc new_esc
      old_esc=$(sed_escape "$old_url")
      new_esc=$(sed_escape "$new_url")

      new_content=$(printf '%s' "$old_content" | sed -E "s|$old_esc|$new_esc|g")

      if [ "$new_content" != "$old_content" ]; then
        wp post update "$page_id" --post_content="$new_content" --allow-root >> "$LOG_FILE" 2>&1
        echo "    [OK] Page: $label ($slug) replaced: $old_url -> $new_url" | tee -a "$LOG_FILE"
      else
        echo "    [SKIP] Page: $label ($slug) old_url not found" | tee -a "$LOG_FILE"
      fi
    }

    # --- ฟังก์ชัน 2: จัดการ Shortcut Bar (Blocksy) ---
    update_shortcuts_bar() {
      local target_url="$1"   # ลิงก์ใหม่ที่จะใส่
      local search_url="$2"   # ลิงก์เดิมที่จะค้นหา (ถ้าว่างจะใช้ google.com)

      [ -z "$search_url" ] && search_url="https://google.com"

      echo "    [BT] Targeting Blocksy Shortcut Bar: '$search_url' -> '$target_url'..." | tee -a "$LOG_FILE"
      wp search-replace "$search_url" "$target_url" wp_options --include-columns=option_value --allow-root >> "$LOG_FILE" 2>&1
      echo "    [OK] Shortcut Bar processed" | tee -a "$LOG_FILE"
    }

    # --- ฟังก์ชัน 3: ค้นหาและแทนที่ทั้งฐานข้อมูล (Global) ---
    update_option_url() {
      local old_url="$1"
      local new_url="$2"
      if [ -n "$old_url" ] && [ -n "$new_url" ]; then
        echo "    [DB] Global Replace: '$old_url' -> '$new_url'..." | tee -a "$LOG_FILE"
        wp search-replace "$old_url" "$new_url" --all-tables --allow-root >> "$LOG_FILE" 2>&1
        echo "    [OK] Global database updated" | tee -a "$LOG_FILE"
      fi
    }

    # ---------------- RUN LOGIC ----------------

    # ✅ Page content replace (only old_url -> new_url) for 3 pages
    # -O = old url (ที่ต้องการหา)
    # -L/-R/-C = new url ของแต่ละหน้า
    [ -n "$LOGIN_REDIRECT_URL" ]    && replace_in_page_content "login"      "Login"    "$OLD_URL_TARGET" "$LOGIN_REDIRECT_URL"
    [ -n "$REGISTER_REDIRECT_URL" ] && replace_in_page_content "register"   "Register" "$OLD_URL_TARGET" "$REGISTER_REDIRECT_URL"
    [ -n "$NEW_CONTACT_URL" ]       && replace_in_page_content "contact-us" "Contact"  "$OLD_URL_TARGET" "$NEW_CONTACT_URL"

    # ✅ Blocksy Shortcut Bar (wp_options only)
    [ -n "$FIX_SHORTCUT_URL" ] && update_shortcuts_bar "$FIX_SHORTCUT_URL" "$OLD_URL_TARGET"

    # ✅ Global DB replace (all tables) only when -O and -N are provided
    [ -n "$OLD_URL_TARGET" ] && [ -n "$NEW_URL_VALUE" ] && update_option_url "$OLD_URL_TARGET" "$NEW_URL_VALUE"

    # --- ล้าง Cache (Cloudways / Redis) ---
    echo "    [CACHE] Flushing Cache..." | tee -a "$LOG_FILE"
    wp cache flush --allow-root &>/dev/null || true
    wp varnish purge --allow-root &>/dev/null 2>&1 || true

    exit 0
  )

  if [ $? -eq 0 ]; then
    ((SUCCESS_COUNT++))
  else
    ((FAILED_COUNT++))
  fi

done <<< "$ALL_SITES_LIST"

echo "------------------------------------------------" | tee -a "$LOG_FILE"
echo "Summary: Success $SUCCESS_COUNT | Failed $FAILED_COUNT" | tee -a "$LOG_FILE"
echo "Detailed Log: $LOG_FILE"
