#!/bin/bash
# zol2o - Pro Version (Optimized for Blocksy & Global Search)
# ✅ Page mode: replace only old_url -> new_url inside page content (login/register/contact-us)
# ✅ Blocksy shortcut bar replace (wp_options.option_value)
# ✅ Global DB replace (all tables)
# ✅ NEW: -D Dry Run (no changes)
# ✅ NEW: -S Single domain filter (only 1 site by wp option home)

LOGIN_REDIRECT_URL=""
REGISTER_REDIRECT_URL=""
NEW_CONTACT_URL=""
OLD_URL_TARGET=""
NEW_URL_VALUE=""
FIX_SHORTCUT_URL=""
ONLY_DOMAIN=""
DRY_RUN=0

while getopts "L:R:C:O:N:F:S:D" opt; do
  case $opt in
    L) LOGIN_REDIRECT_URL="$OPTARG" ;;
    R) REGISTER_REDIRECT_URL="$OPTARG" ;;
    C) NEW_CONTACT_URL="$OPTARG" ;;
    O) OLD_URL_TARGET="$OPTARG" ;;
    N) NEW_URL_VALUE="$OPTARG" ;;
    F) FIX_SHORTCUT_URL="$OPTARG" ;;
    S) ONLY_DOMAIN="$OPTARG" ;;
    D) DRY_RUN=1 ;;
    \?) exit 1 ;;
  esac
done

# เช็ค Argument
if [ -z "$LOGIN_REDIRECT_URL" ] && [ -z "$REGISTER_REDIRECT_URL" ] && [ -z "$NEW_CONTACT_URL" ] && [ -z "$OLD_URL_TARGET" ] && [ -z "$FIX_SHORTCUT_URL" ]; then
  echo "Usage:"
  echo "  $0 -O old_base_url -L new_login_url -R new_register_url -C new_contact_url [-S site_home] [-D]"
  echo "  $0 -O old_url -N new_url            # Global DB replace (all tables) [-S site_home] [-D]"
  echo "  $0 -F target_url -O search_url      # Blocksy Shortcut Bar replace (wp_options) [-S site_home] [-D]"
  exit 1
fi

BASE_DIR="$HOME/applications"
LOG_FILE="$HOME/update_wp.log"

> "$LOG_FILE"
echo "------ Update started at $(date) ------" >> "$LOG_FILE"
[ "$DRY_RUN" -eq 1 ] && echo "------ DRY RUN MODE (no changes will be applied) ------" | tee -a "$LOG_FILE"
[ -n "$ONLY_DOMAIN" ] && echo "------ TARGET ONLY DOMAIN: $ONLY_DOMAIN ------" | tee -a "$LOG_FILE"

ALL_SITES_LIST=$(find -L "$BASE_DIR" -name "wp-config.php" ! -path "*/.*")
TOTAL_SITES=$(echo "$ALL_SITES_LIST" | grep -c "wp-config.php")

if [ "$TOTAL_SITES" -eq 0 ]; then
  echo "Error: No WordPress installations found." | tee -a "$LOG_FILE"
  exit 1
fi

echo "Found $TOTAL_SITES WordPress" | tee -a "$LOG_FILE"

SUCCESS_COUNT=0
FAILED_COUNT=0
CURRENT_INDEX=0

while read -r config_path; do
  [ -z "$config_path" ] && continue

  ((CURRENT_INDEX++))
  SITE_PATH=$(dirname "$config_path")
  DISPLAY_NAME=$(echo "$SITE_PATH" | sed "s|$BASE_DIR/||")

  (
    cd "$SITE_PATH" || exit 1

    DOMAIN=$(wp option get home --allow-root 2>/dev/null || echo "Unknown Domain")
    echo "------------------------------------------------" | tee -a "$LOG_FILE"
    echo "[$CURRENT_INDEX/$TOTAL_SITES] Site: $DOMAIN ($DISPLAY_NAME)" | tee -a "$LOG_FILE"

    # เลือกเฉพาะ 1 โดเมน (-S) ต้องตรงกับค่า home แบบเป๊ะ
    if [ -n "$ONLY_DOMAIN" ] && [ "$DOMAIN" != "$ONLY_DOMAIN" ]; then
      echo "    [SKIP] Not target domain (-S $ONLY_DOMAIN)" | tee -a "$LOG_FILE"
      exit 0
    fi

    # Escape string for safe sed replacement
    sed_escape() { printf '%s' "$1" | sed -e 's/[\/&|\\]/\\&/g'; }

    # Find WP page ID by slug or slug-2 (published pages)
    find_page_id() {
      local slug="$1"
      wp post list --post_type=page --post_status=publish \
        --fields=ID,post_name --format=csv --allow-root \
        | awk -F',' -v s="$slug" '($2==s || $2==s"-2"){print $1; exit}'
    }

    # ✅ Replace in page content: old_url -> new_url (เจาะจง ไม่ทับลิงก์อื่น)
    replace_in_page_content() {
      local slug="$1" label="$2" old_url="$3" new_url="$4"
      [ -z "$old_url" ] && return 0
      [ -z "$new_url" ] && return 0

      local page_id old_content new_content old_esc new_esc
      page_id=$(find_page_id "$slug")

      if [ -z "$page_id" ]; then
        echo "    [SKIP] Page not found: $label ($slug)" | tee -a "$LOG_FILE"
        return 0
      fi

      old_content=$(wp post get "$page_id" --field=post_content --allow-root 2>/dev/null || true)

      old_esc=$(sed_escape "$old_url")
      new_esc=$(sed_escape "$new_url")
      new_content=$(printf '%s' "$old_content" | sed -E "s|$old_esc|$new_esc|g")

      if [ "$new_content" != "$old_content" ]; then
        if [ "$DRY_RUN" -eq 1 ]; then
          echo "    [DRY] Page: $label ($slug) WOULD replace: $old_url -> $new_url" | tee -a "$LOG_FILE"
        else
          wp post update "$page_id" --post_content="$new_content" --allow-root >> "$LOG_FILE" 2>&1
          echo "    [OK] Page: $label ($slug) replaced: $old_url -> $new_url" | tee -a "$LOG_FILE"
        fi
      else
        echo "    [SKIP] Page: $label ($slug) old_url not found" | tee -a "$LOG_FILE"
      fi
    }

    # ✅ Blocksy Shortcut Bar replace (wp_options only)
    update_shortcuts_bar() {
      local target_url="$1" search_url="$2"
      [ -z "$search_url" ] && search_url="https://google.com"

      if [ "$DRY_RUN" -eq 1 ]; then
        echo "    [DRY] Blocksy Shortcut Bar WOULD replace: '$search_url' -> '$target_url' (wp_options.option_value)" | tee -a "$LOG_FILE"
        wp search-replace "$search_url" "$target_url" wp_options --include-columns=option_value --allow-root --dry-run >> "$LOG_FILE" 2>&1 || true
      else
        echo "    [BT] Targeting Blocksy Shortcut Bar: '$search_url' -> '$target_url'..." | tee -a "$LOG_FILE"
        wp search-replace "$search_url" "$target_url" wp_options --include-columns=option_value --allow-root >> "$LOG_FILE" 2>&1
        echo "    [OK] Shortcut Bar processed" | tee -a "$LOG_FILE"
      fi
    }

    # ✅ Global DB replace (all tables)
    update_option_url() {
      local old_url="$1" new_url="$2"
      [ -z "$old_url" ] && return 0
      [ -z "$new_url" ] && return 0

      if [ "$DRY_RUN" -eq 1 ]; then
        echo "    [DRY] Global DB WOULD replace: '$old_url' -> '$new_url' (all tables)" | tee -a "$LOG_FILE"
        wp search-replace "$old_url" "$new_url" --all-tables --allow-root --dry-run >> "$LOG_FILE" 2>&1 || true
      else
        echo "    [DB] Global Replace: '$old_url' -> '$new_url'..." | tee -a "$LOG_FILE"
        wp search-replace "$old_url" "$new_url" --all-tables --allow-root >> "$LOG_FILE" 2>&1
        echo "    [OK] Global database updated" | tee -a "$LOG_FILE"
      fi
    }

    # ---------------- RUN LOGIC ----------------

    # ถ้า -O เป็น base (เช่น https://old.com) ให้ประกอบเป็น /login /register /contact-us อัตโนมัติ
    OLD_BASE="${OLD_URL_TARGET%/}"

    [ -n "$LOGIN_REDIRECT_URL" ]    && replace_in_page_content "login"      "Login"    "${OLD_BASE}/login"      "$LOGIN_REDIRECT_URL"
    [ -n "$REGISTER_REDIRECT_URL" ] && replace_in_page_content "register"   "Register" "${OLD_BASE}/register"   "$REGISTER_REDIRECT_URL"
    [ -n "$NEW_CONTACT_URL" ]       && replace_in_page_content "contact-us" "Contact"  "${OLD_BASE}/contact-us" "$NEW_CONTACT_URL"

    # Blocksy shortcut bar
    [ -n "$FIX_SHORTCUT_URL" ] && update_shortcuts_bar "$FIX_SHORTCUT_URL" "$OLD_URL_TARGET"

    # Global replace ทำเฉพาะตอนมี -N
    [ -n "$NEW_URL_VALUE" ] && update_option_url "$OLD_URL_TARGET" "$NEW_URL_VALUE"

    # Cache (ไม่จำเป็นใน dry-run)
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "    [DRY] CACHE would flush" | tee -a "$LOG_FILE"
    else
      echo "    [CACHE] Flushing Cache..." | tee -a "$LOG_FILE"
      wp cache flush --allow-root &>/dev/null || true
      wp varnish purge --allow-root &>/dev/null 2>&1 || true
    fi

    exit 0
  )

  if [ $? -eq 0 ]; then
    ((SUCCESS_COUNT++))
  else
    ((FAILED_COUNT++))
  fi

done <<< "$ALL_SITES_LIST"

echo "------------------------------------------------" | tee -a "$LOG_FILE"
echo "Summary: Success $SUCCESS_COUNT | Failed $FAILED_COUNT" | tee -a "$LOG_FILE"
echo "Detailed Log: $LOG_FILE"
